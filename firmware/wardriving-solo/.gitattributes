# Keep the exported patch and its source bytes reproducible on Windows too.
*.c text eol=lf
*.h text eol=lf
*.inc text eol=lf
# Unified-diff context preserves whitespace from the pinned upstream source.
*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof
# Keep the unmodified upstream partition template, including its final blank line.
build-inputs/partitions.csv.example -text whitespace=-blank-at-eof
